load("@rules_cc//cc:defs.bzl", "cc_toolchain")

filegroup(name = "empty_dwp")

filegroup(name = "empty_objcopy")

filegroup(name = "empty_strip")

cc_toolchain(
    name = "llvm",
    all_files = "//toolchain/cc/llvm/files:all_files",
    ar_files = "//toolchain/cc/llvm/files:ar_files",
    compiler_files = "//toolchain/cc/llvm/files:compiler_files",
    dwp_files = ":empty_dwp",
    linker_files = "//toolchain/cc/llvm/files:linker_files",
    objcopy_files = ":empty_objcopy",
    strip_files = ":empty_strip",
    toolchain_config = "//toolchain/cc/llvm:config",
)
